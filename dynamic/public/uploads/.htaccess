Options -Indexes
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule \.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml)$ - [F,L,NC]
</IfModule>
<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml|htaccess)$">
  Require all denied
</FilesMatch>
