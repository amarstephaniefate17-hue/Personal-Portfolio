# Copy these values into the hosting provider's private environment-variable panel.
# Do not upload or commit real credentials.
PORTFOLIO_DB_HOST=localhost
PORTFOLIO_DB_PORT=3306
PORTFOLIO_DB_NAME=your_database_name
PORTFOLIO_DB_USER=your_database_user
PORTFOLIO_DB_PASSWORD=replace_with_private_database_password
PORTFOLIO_LOGIN_SALT=replace_with_a_long_random_secret
PORTFOLIO_BASE_URL=
PORTFOLIO_SECURE_COOKIES=1
PORTFOLIO_DEBUG=0
